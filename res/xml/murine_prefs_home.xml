<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        android:key="pref_add_icon_to_home"
        android:title="@string/auto_add_shortcuts_label"
        android:summary="@string/auto_add_shortcuts_description"
        android:defaultValue="false"
        android:persistent="true"
        launcher:logIdOn="613"
        launcher:logIdOff="614" />
    <!--
      LAUNCHER_HOME_SCREEN_ROTATION_ENABLED(615)
      LAUNCHER_HOME_SCREEN_ROTATION_DISABLED(616)
    -->
    <SwitchPreferenceCompat
        android:icon="@drawable/ic_settings_home"
        android:key="pref_allowRotation"
        android:title="@string/allow_rotation_title"
        android:summary="@string/allow_rotation_desc"
        android:defaultValue="false"
        android:persistent="true"
        launcher:logIdOn="615"
        launcher:logIdOff="616" />

    <PreferenceCategory android:title="@string/pref_subcategory_layout">
        <com.android.settingslib.widget.ExpandablePreference
            android:title="@string/grid_size_title"
            android:summary="@string/grid_size_desc">
            <app.murinelauncher.widget.CustomSeekBarPreference
                android:title="Grid Width"
                android:key="pref_grid_size_width"
                android:defaultValue="4"
                android:min="3"
                android:max="10">
            </app.murinelauncher.widget.CustomSeekBarPreference>

            <app.murinelauncher.widget.CustomSeekBarPreference
                android:title="Grid Height"
                android:key="pref_grid_size_height"
                android:defaultValue="5"
                android:min="3"
                android:max="10">
            </app.murinelauncher.widget.CustomSeekBarPreference>
        </com.android.settingslib.widget.ExpandablePreference>
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
