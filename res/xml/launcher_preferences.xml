<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.launcher3.settings.NotificationDotsPreference
        android:key="pref_icon_badging"
        android:title="@string/notification_dots_title"
        android:persistent="false"
        android:widgetLayout="@layout/notification_pref_warning" />

    <!--
      LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_ENABLED(613)
      LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_DISABLED(614)
    -->
    <SwitchPreferenceCompat
        android:key="pref_add_icon_to_home"
        android:title="@string/auto_add_shortcuts_label"
        android:summary="@string/auto_add_shortcuts_description"
        android:defaultValue="true"
        android:persistent="true"
        launcher:logIdOn="613"
        launcher:logIdOff="614" />

    <!--
      LAUNCHER_HOME_SCREEN_ROTATION_ENABLED(615)
      LAUNCHER_HOME_SCREEN_ROTATION_DISABLED(616)
    -->
    <SwitchPreferenceCompat
        android:icon="@drawable/ic_settings_home"
        android:key="pref_allowRotation"
        android:title="@string/allow_rotation_title"
        android:summary="@string/allow_rotation_desc"
        android:defaultValue="false"
        android:persistent="true"
        launcher:logIdOn="615"
        launcher:logIdOff="616" />

    <com.android.settingslib.widget.SpacePreference/>

    <com.android.settingslib.widget.ExpandablePreference
        android:title="@string/grid_size_title"
        android:summary="@string/grid_size_desc">
        <app.murinelauncher.widget.CustomSeekBarPreference
            android:title="Grid Width"
            android:key="pref_grid_size_width"
            android:defaultValue="4"
            android:min="3"
            android:max="10">
        </app.murinelauncher.widget.CustomSeekBarPreference>

        <app.murinelauncher.widget.CustomSeekBarPreference
            android:title="Grid Height"
            android:key="pref_grid_size_height"
            android:defaultValue="5"
            android:min="3"
            android:max="10">
        </app.murinelauncher.widget.CustomSeekBarPreference>
    </com.android.settingslib.widget.ExpandablePreference>

    <com.android.settingslib.widget.SpacePreference/>


    <PreferenceCategory android:title="@string/safemode_shortcut_error" android:key="sfasfsadf">
        <SwitchPreferenceCompat
            android:persistent="true"
            android:title="@string/safemode_shortcut_error"
            android:key="pref_recents_meminfo"
            android:defaultValue="false"
            launcher:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <app.murinelauncher.widget.CustomSeekBarPreference android:max="100"
        android:title="Test seekbar"
        android:key="pref_app_drawer_opacity"
        android:defaultValue="100"
        android:min="0">

    </app.murinelauncher.widget.CustomSeekBarPreference>

    <Preference
        android:icon="@drawable/ic_settings_icons"
        android:title="Title example"
        android:key="miscellaneous"
        android:summary="Summary example"
        android:fragment="com.android.launcher3.settings.SettingsActivity$LauncherSettingsFragment"/>
    <Preference
        android:icon="@drawable/ic_settings_home"
        android:title="Title example"
        android:key="miscellaneous"
        android:summary="Summary example"
        android:fragment="com.android.launcher3.settings.SettingsActivity$LauncherSettingsFragment"/>
    <Preference
        android:icon="@drawable/ic_settings_drawer"
        android:title="Title example"
        android:key="miscellaneous"
        android:summary="Summary example"
        android:fragment="com.android.launcher3.settings.SettingsActivity$LauncherSettingsFragment"/>
    <Preference
        android:icon="@drawable/ic_settings_misc"
        android:title="Title example"
        android:key="miscellaneous"
        android:summary="Summary example"
        android:fragment="com.android.launcher3.settings.SettingsActivity$LauncherSettingsFragment"/>

</androidx.preference.PreferenceScreen>
