<?xml version="1.0" encoding="utf-8"?>
<app.murinelauncher.widget.smartspace.MurineClockView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/murine_clock_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="@dimen/_10sdp">

    <!-- scalable view that acts as top padding -->
    <View
        android:layout_gravity="start"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <TextClock
        android:id="@+id/murine_clock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="start"
        android:layout_weight="11"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/murine_gantari"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:autoSizeMinTextSize="0.1sp"
        android:autoSizeStepGranularity="1sp"
        android:singleLine="true"
        android:textColor="?attr/workspaceTextColor"
        android:textSize="72sp" />

    <TextClock
        android:id="@+id/murine_clock_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="start"
        android:layout_marginTop="@dimen/_1sdp"
        android:layout_weight="3"
        android:alpha="0.85"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/murine_gantari"
        android:format12Hour="EEEE MMMM d"
        android:format24Hour="EEEE MMMM d"
        android:includeFontPadding="false"
        android:autoSizeMinTextSize="0.1sp"
        android:autoSizeStepGranularity="0.1sp"
        android:shadowColor="#A0000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:singleLine="true"
        android:textColor="?attr/workspaceTextColor"
        android:textSize="16sp" />
</app.murinelauncher.widget.smartspace.MurineClockView>
