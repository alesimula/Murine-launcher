<?xml version="1.0" encoding="utf-8"?>
<app.murinelauncher.widget.search.MurineSearchBoxView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/search_box_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/murine_search_box_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.android.launcher3.ExtendedEditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/murine_search_input_bg"
                android:hint="@string/murine_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary" />

            <FrameLayout
                android:id="@+id/search_voice_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:visibility="gone">

                <View
                    android:id="@+id/search_voice_level"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/murine_search_voice_level" />

                <ProgressBar
                    android:id="@+id/search_voice_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/search_voice_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/murine_search_btn_ripple"
                    android:contentDescription="@string/murine_voice_search_desc"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_qsb_murine_mic"
                    android:tint="@color/murine_search_icon_tint" />
            </FrameLayout>
        </FrameLayout>

        <app.murinelauncher.widget.SpringRecyclerView
            android:id="@+id/search_history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:layout_marginTop="8dp"
            android:maxHeight="300dp"
            android:visibility="gone" />

    </LinearLayout>
</app.murinelauncher.widget.search.MurineSearchBoxView>
